# ─────────────────────────────────────────────────────────────────────────────
#  FOLDY API CONSOLE — deploy settings.  COPY THIS FILE TO  deploy.env  AND FILL IT IN.
#
#      Copy-Item .\deploy.env.example .\deploy.env ; notepad .\deploy.env
#      npm run deploy
#
#  deploy.env is GIT-IGNORED. Never commit it and never paste it into chat.
#  Use FORWARD slashes for the remote (Linux) path.
#
#  THIS IS THE INTERNAL DEV CONSOLE. It browses the whole 296-endpoint backend
#  surface, so anyone who can reach this host learns the shape of the API. Put
#  it on a private host or behind the same access control as the admin web.
# ─────────────────────────────────────────────────────────────────────────────

# ── where to deploy ──
DEPLOY_HOST=REPLACE.your.server
DEPLOY_PORT=22
DEPLOY_USER=ubuntu

# ── how to authenticate ──
# Set EITHER a key OR a password. A key wins if both are set: it is fully
# unattended and nothing sensitive ever reaches a command line.
#
#   DEPLOY_SSH_KEY=C:\Users\posh\.ssh\foldy-dev-server-keypair.pem
# Keep the key OUTSIDE the repo.
DEPLOY_SSH_KEY=
#
# DEPLOY_PASSWORD — needs PuTTY on PATH (winget install PuTTY.PuTTY), because
#   Windows' own ssh/scp cannot accept a password non-interactively. Leave it
#   BLANK and the script prompts for it instead, which keeps it off disk.
DEPLOY_PASSWORD=
#
# Optional override: key | password | agent. Blank = decided from the two above.
DEPLOY_AUTH=

# ── the nginx document root ──
# The whole directory is REPLACED on each deploy, and the previous build is kept
# alongside it as <root>.prev. Point this at the site root only — never at
# something like /var/www, or you would move the lot aside.
DEPLOY_REMOTE_ROOT=/var/www/foldy_api_console

# true if that path is root-owned (needs passwordless sudo, or you get prompted)
DEPLOY_USE_SUDO=false

# Optional. Ownership the swapped-in directory should end up with, e.g.
# www-data:www-data. Blank = leave ownership alone.
DEPLOY_CHOWN=
